#!/system/bin/sh
set -u
BASE="${0%/*}"
MODDIR="$(cd "$BASE/../.." 2>/dev/null && pwd)"
TMP="/data/local/tmp/dragx_turbo"
mkdir -p "$TMP" 2>/dev/null || true
log(){ printf '%s\n' "$*"; }
prop(){ getprop "$1" 2>/dev/null; }
top_pkg(){ dumpsys activity processes 2>/dev/null | grep -m1 'top-activity' | sed 's#.*:# #' | awk '{print $1}' | cut -d/ -f1; }
game_like(){ case "$1" in com.dts.*|com.garena.*|com.activision.*|com.tencent.*|com.pubg*|com.mobile.legends|com.epicgames.*|com.ea.gp.*|com.axlebolt.*|com.riotgames.*|com.roblox.*) return 0;; esac; return 1; }
cache_clean(){
  [ "$(id -u 2>/dev/null)" = 0 ] || { log 'ERROR|root_required'; return 2; }
  log 'CACHE|trim-start'
  pm trim-caches 1073741824 >/dev/null 2>&1 || true
  cmd activity trim-caches >/dev/null 2>&1 || true
  log 'CACHE|trim-complete'
}
gms_clean(){
  [ "$(id -u 2>/dev/null)" = 0 ] || { log 'ERROR|root_required'; return 2; }
  if pm path com.google.android.gms >/dev/null 2>&1; then
    pm trim-caches 536870912 >/dev/null 2>&1 || true
    rm -rf /data/user_de/0/com.google.android.gms/cache/* /data/user_de/0/com.google.android.gms/code_cache/* 2>/dev/null || true
    rm -rf /data/data/com.google.android.gms/cache/* /data/data/com.google.android.gms/code_cache/* 2>/dev/null || true
    log 'GMS|cache-maintained'
  else log 'GMS|not-installed'; fi
}
prefetch(){
  [ "$(id -u 2>/dev/null)" = 0 ] || { log 'ERROR|root_required'; return 2; }
  pkg="${1:-$(top_pkg)}"
  [ -n "$pkg" ] || { log 'ERROR|no_game_detected'; return 3; }
  game_like "$pkg" || log "PREFETCH|package=$pkg|classification=generic"
  apk="$(pm path "$pkg" 2>/dev/null | head -n1 | cut -d: -f2)"
  [ -n "$apk" ] && [ -f "$apk" ] && { cat "$apk" >/dev/null 2>&1 || true; log "PREFETCH|apk-warmed=$apk"; }
  for d in "/data/data/$pkg/code_cache" "/data/data/$pkg/cache" "/data/user/0/$pkg/cache"; do
    [ -d "$d" ] || continue
    find "$d" -type f -size -16M -print 2>/dev/null | head -n 128 | while IFS= read -r f; do cat "$f" >/dev/null 2>&1 || true; done
  done
  log "PREFETCH|complete|package=$pkg"
}
flinger(){
  sf="$(dumpsys SurfaceFlinger 2>/dev/null)"
  period="$(printf '%s\n' "$sf" | grep -m1 -E 'VSYNC period|vsyncPeriod' | grep -oE '[0-9]{7,}' | head -n1)"
  fps="unknown"; [ -n "$period" ] && fps="$(awk -v p="$period" 'BEGIN{printf "%.2f",1000000000/p}')"
  missed="$(printf '%s\n' "$sf" | grep -m1 'Total missed frame count' | awk '{print $NF}')"
  log "FLINGER|refresh_estimate=$fps|vsync_ns=${period:-unknown}|missed=${missed:-unknown}"
}
display(){ "$MODDIR/backend/display_hardware.sh" "$@"; }
status(){
  log "DRAGX_TURBO|version=0.4.0"
  log "DEVICE|manufacturer=$(prop ro.product.manufacturer)|model=$(prop ro.product.model)|android=$(prop ro.build.version.release)|sdk=$(prop ro.build.version.sdk)|abi=$(prop ro.product.cpu.abi)"
  log "GAME|top=$(top_pkg)"
  display status
}
boot(){
  log "BOOT|Drag X TURBO online"
  mkdir -p "$TMP"
  status >"$TMP/status.log" 2>&1 || true
}
case "${1:-status}" in
 status) status;;
 boot) boot;;
 display) shift; display "$@";;
 cache-clean) cache_clean;;
 gms-clean) gms_clean;;
 prefetch) shift; prefetch "${1:-}";;
 flinger) flinger;;
 turbo) prefetch "$(top_pkg)"; cache_clean; gms_clean; flinger;;
 game-profile) prefetch "$(top_pkg)";;
 restore) log 'RESTORE|No persistent global overrides are held by Drag X TURBO 0.4.0';;
 *) log 'Drag X TURBO 0.4.0'; log 'Commands: status | boot | turbo | game-profile | prefetch [package] | cache-clean | gms-clean | flinger | display status | display apply <hz> [display_id] | restore'; exit 2;;
esac
